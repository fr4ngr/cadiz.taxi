{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-06-26",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "gaditan",
	"pages_build_output_dir": "dist",
	"observability": {
		"enabled": true
	},
	"ai": {
		"binding": "AI"
	},
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "cadiz-knowledge-index",
			"remote": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cadiz-chat",
			"database_id": "cc0e148a-210f-454a-8ece-404442858c82"
		},
		{
			"binding": "gaditan_data",
			"database_name": "gaditan-data",
			"database_id": "a0c7c621-f5b1-400a-af2f-45eb56643302"
		}
	],
	"r2_buckets": [
		{
			"binding": "AVATAR_BUCKET",
			"bucket_name": "cadiz-avatars"
		},
		{
			"binding": "BUCKET",
			"bucket_name": "cadiz-media"
		}
	]
}