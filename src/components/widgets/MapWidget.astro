                                <div style="display: flex; align-items: flex-start; justify-content: space-between; background: linear-gradient(to right, transparent, ${isInactive ? '#94a3b8' : station.color}15); padding: 12px; border-radius: 8px; border-left: 4px solid ${isInactive ? '#94a3b8' : station.color};">
                                    <div style="width: 100%;">
