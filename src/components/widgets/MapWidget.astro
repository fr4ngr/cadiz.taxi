                    const isInactive = station.timestamp ? Math.floor((Date.now() - station.timestamp) / 60000) > 1440 : true;
                    const eaqiRange = isInactive || station.aqi === 'N/D' ? 'N/D' : (station.aqi <= 20 ? '0-20' : (station.aqi <= 40 ? '21-40' : (station.aqi <= 60 ? '41-60' : (station.aqi <= 100 ? '61-100' : '>100'))));
                    let timeStr = 'recientemente';
                    if (station.timestamp) {
