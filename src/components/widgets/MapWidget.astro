---
// src/components/widgets/MapWidget.astro
---

<!-- TAB MAPA -->
<div id="tab-mapa" style="display: none; flex: 1; flex-direction: column; width: 100%; min-height: 0; position: relative; background: var(--bg-color);">

    <!-- Contenedor UI de la InfoPill -->
    <div id="map-ui-container" style="position: absolute; top: 16px; left: 50%; z-index: 1001; transform: translateX(-50%); width: calc(100% - 32px); max-width: 448px; display: flex; flex-direction: column; gap: 8px; transition: opacity 0.3s, transform 0.3s; opacity: 0; pointer-events: none;">
        <!-- Píldora informativa de parada -->
        <div id="map-info-pill" style="background: var(--header-bg); border-radius: 20px; padding: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.15); display: flex; flex-direction: column; gap: 14px; border: 1px solid var(--header-border);">
        
        <div style="display: flex; align-items: flex-start; gap: 12px;">
            <div style="flex: 1;">
                <div id="map-info-label" style="font-size: 10px; font-weight: 700; color: var(--primary-color); letter-spacing: 0.5px; text-transform: uppercase; margin-bottom: 2px;">UBICACIÓN</div>
                <h3 id="map-info-title" style="margin: 0; font-size: 16px; color: var(--text-primary); font-weight: 600;">Nombre</h3>
                <div id="map-info-desc" style="margin: 3px 0 0 0; font-size: 13px; color: var(--text-secondary); line-height: 1.3;">Descripción</div>
            </div>
            <button id="btn-close-map-pill" style="background: var(--chat-bg); border: none; font-size: 14px; color: var(--text-secondary); cursor: pointer; width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; transition: background 0.2s; flex-shrink: 0; z-index: 9999;" aria-label="Cerrar información">✕</button>
        </div>

        <div id="map-pill-actions" style="display: flex; gap: 10px;">
            <button id="pill-btn-directions" onclick="window.mapActionDirections()" style="flex: 1; padding: 10px; border-radius: 12px; border: none; background: var(--primary-color); color: white; font-weight: 600; font-size: 13px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 6px; transition: opacity 0.2s;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 11 22 2 13 21 11 13 3 11"></polygon></svg>
                Cómo ir
            </button>
        </div>
        
        <!-- Instrucción paso a paso (aparece al pedir indicaciones) -->
        <div id="route-instruction" style="display: none; width: 100%; align-items: center; gap: 14px; padding: 12px; border-radius: 16px; background: var(--chat-bg); border: 1px solid var(--header-border);">
            <div style="background: var(--primary-color); color: white; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 19V5" />
                    <path d="M5 12l7-7 7 7" />
                </svg>
            </div>
            <div style="display: flex; flex-direction: column; gap: 2px;">
                <span id="route-instruction-action" style="font-size: 15px; font-weight: 700; color: var(--text-primary);">Calculando...</span>
                <span id="route-instruction-street" style="font-size: 12px; font-weight: 500; color: var(--text-secondary);">Buscando ruta a pie</span>
            </div>
        </div>
        </div>
        
        <!-- Píldoras flotantes de ruta (Distancia y Tiempo) debajo de la tarjeta -->
        <div id="map-floating-route-stats" style="display: none; justify-content: flex-end; gap: 8px; pointer-events: none;">
            <div id="route-time" style="background: var(--primary-color); color: white; padding: 6px 14px; border-radius: 20px; font-size: 14px; font-weight: 700; box-shadow: 0 4px 10px rgba(0,0,0,0.15); pointer-events: auto; display: flex; align-items: center; justify-content: center; height: 32px; box-sizing: border-box;">-- min</div>
            <div id="route-distance" style="background: var(--header-bg); color: var(--text-primary); border: 1px solid var(--header-border); padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; box-shadow: 0 4px 10px rgba(0,0,0,0.15); pointer-events: auto; display: flex; align-items: center; justify-content: center; height: 32px; box-sizing: border-box;">-- m</div>
        </div>
    </div>

    <div id="fullscreen-widget-area" style="width: 100%; max-width: 480px; height: 100%; position: relative; background: var(--bg-color);">
        <!-- Widgets inyectados por JS -->
        <div style="display: flex; height: 100%; align-items: center; justify-content: center; color: var(--text-secondary);">
            Cargando...
        </div>
    </div>

    <!-- Filtros Container (Top) -->
    <div id="map-filters-pills" style="position: absolute; top: 84px; left: 50%; z-index: 1001; width: calc(100% - 32px); display: flex; justify-content: center; gap: 8px; transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); flex-wrap: wrap;">
        <button class="filter-pill active" onclick="window.selectMapLayer('popular')">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path></svg>
            Popular
        </button>
        <button class="filter-pill" onclick="window.selectMapLayer('red')">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            Mi Red
        </button>
        <button class="filter-pill" onclick="window.selectMapLayer('incendios')" style="border-color: #ef4444; color: #ef4444;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path></svg>
            Incendios Activos
        </button>
        <button class="filter-pill" onclick="window.selectMapLayer('embalses')" style="border-color: #3b82f6; color: #3b82f6;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path></svg>
            Embalses
        </button>
        <button class="filter-pill" onclick="window.selectMapLayer('sismos')" style="border-color: #f97316; color: #f97316;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path><path d="M12 19V5"></path><path d="M17 12H7"></path></svg>
            Seísmos
        </button>
        <button class="filter-pill" onclick="window.selectMapLayer('aire')" style="border-color: #10b981; color: #10b981;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.59 4.59A2 2 0 1 1 11 8H2m10.59 11.41A2 2 0 1 0 14 16H2m15.73-8.27A2.5 2.5 0 1 1 19.5 12H2"></path></svg>
            Calidad Aire
        </button>
    </div>

    <!-- RADIAL MENUS CONTAINER -->
    <div id="map-actions-container" style="position: absolute; bottom: 96px; right: 16px; z-index: 1005; display: flex; flex-direction: column; gap: 16px; align-items: flex-end;">
        
        <!-- Add Post Vertical Speed Dial -->
        <div class="radial-menu-wrapper" id="radial-menu-add">
            <button class="radial-pill-item" style="--ty: -200px;" onclick="window.openNewPostModal('photo')">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
                Foto
            </button>
            <button class="radial-pill-item" style="--ty: -140px;" onclick="window.openNewPostModal('video')">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>
                Vídeo
            </button>
            <button class="radial-pill-item" style="--ty: -80px;" onclick="window.openNewPostModal('audio')">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2"></path><line x1="12" y1="19" x2="12" y2="22"></line></svg>
                Nota de voz
            </button>
            
            <button class="radial-main-btn primary" onclick="window.toggleRadialMenu('add')" aria-label="Añadir publicación">
                <div class="plus-icon">+</div>
            </button>
        </div>

        <!-- Filtros Button -->
        <button id="map-filters-btn" class="radial-main-btn" onclick="window.toggleFilters()" aria-label="Filtros">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="21" y1="4" x2="14" y2="4"></line>
                <line x1="10" y1="4" x2="3" y2="4"></line>
                <line x1="21" y1="12" x2="12" y2="12"></line>
                <line x1="8" y1="12" x2="3" y2="12"></line>
                <line x1="21" y1="20" x2="16" y2="20"></line>
                <line x1="12" y1="20" x2="3" y2="20"></line>
                <line x1="14" y1="2" x2="14" y2="6"></line>
                <line x1="8" y1="10" x2="8" y2="14"></line>
                <line x1="16" y1="18" x2="16" y2="22"></line>
            </svg>
        </button>
    </div>
</div>

<style>
    .leaflet-bottom.leaflet-right {
        margin-bottom: 96px !important;
    }
    
    /* Radial Menus */
    .radial-menu-wrapper {
        position: relative;
        width: 56px;
        height: 56px;
    }
    .radial-main-btn {
        position: relative;
        z-index: 2;
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: var(--header-bg);
        border: 1px solid var(--header-border);
        color: var(--text-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        cursor: pointer;
        transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), background-color 0.2s;
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
    }
    .radial-main-btn.primary {
        background: var(--primary-color);
        color: white;
        border: none;
    }
    .radial-main-btn .plus-icon {
        font-size: 28px;
        transition: transform 0.3s;
    }
    .radial-menu-wrapper.open .radial-main-btn .plus-icon {
        transform: rotate(45deg);
    }
    .radial-menu-wrapper.open .radial-main-btn:not(.primary) svg {
        transform: scale(0.9);
        opacity: 0.8;
    }

    .radial-pill-item {
        position: absolute;
        right: 0;
        top: 6px;
        height: 44px;
        padding: 0 16px;
        border-radius: 22px;
        background: color-mix(in srgb, var(--header-bg) 85%, transparent);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid var(--header-border);
        color: var(--text-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.15);
        cursor: pointer;
        opacity: 0;
        pointer-events: none;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        z-index: 1;
        font-size: 14px;
        font-weight: 600;
        white-space: nowrap;
        transform-origin: right center;
    }
    .radial-menu-wrapper.open .radial-pill-item {
        opacity: 1;
        pointer-events: auto;
        transform: translate(0, var(--ty));
    }
    .radial-menu-wrapper.open .radial-pill-item:nth-child(1) { transition-delay: 0.05s; }
    .radial-menu-wrapper.open .radial-pill-item:nth-child(2) { transition-delay: 0.1s; }
    .radial-menu-wrapper.open .radial-pill-item:nth-child(3) { transition-delay: 0.15s; }

    #map-filters-pills {
        opacity: 0;
        pointer-events: none;
        transform: translateX(-50%) translateY(-20px);
    }
    #map-filters-pills.open {
        opacity: 1;
        pointer-events: auto;
        transform: translateX(-50%) translateY(0);
    }
    .filter-pill {
        display: flex;
        align-items: center;
        gap: 6px;
        background: color-mix(in srgb, var(--header-bg) 85%, transparent);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid var(--header-border);
        border-radius: 20px;
        padding: 8px 16px;
        color: var(--text-primary);
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        transition: all 0.2s;
        white-space: nowrap;
    }
    .filter-pill:hover {
        background: rgba(255,255,255,0.05);
    }
    .filter-pill.active {
        background: var(--primary-color);
        color: white;
        border-color: var(--primary-color);
    }
</style>
<style is:global>
    @keyframes pulse-fire {
        0% { transform: scale(0.9); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
        70% { transform: scale(1.1); box-shadow: 0 0 0 10px rgba(239, 68, 68, 0); }
        100% { transform: scale(0.9); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
    }
    
    .fire-marker-icon {
        background: #ef4444;
        border: 2px solid #fff;
        border-radius: 50%;
        animation: pulse-fire 1.5s infinite;
    }
    
    .fire-marker-icon.high-intensity {
        background: #b91c1c;
        animation: pulse-fire 1s infinite;
    }
</style>

<script>
    if (typeof window !== 'undefined') {
        const btnClose = document.getElementById('btn-close-map-pill');
        if (btnClose) {
            btnClose.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                
                const pill = document.getElementById('map-ui-container');
                const routeStats = document.getElementById('map-floating-route-stats');
                const instruction = document.getElementById('route-instruction');
                const actions = document.getElementById('map-pill-actions');
                
                if (pill) {
                    pill.style.opacity = '0';
                    pill.style.pointerEvents = 'none';
                    pill.style.transform = 'translateX(-50%) translateY(20px)';
                }
                if (routeStats) routeStats.style.display = 'none';
                if (instruction) instruction.style.display = 'none';
                if (actions) actions.style.display = 'flex';
                
                // Si hay ruta dibujada, limpiarla (opcional, pero buena UX)
                if (window.currentRouteControl && window.map) {
                    try {
                        window.map.removeControl(window.currentRouteControl);
                        window.currentRouteControl = null;
                    } catch(err) {}
                }
            });
        }

        window.toggleRadialMenu = function(menuId) {
            const wrapper = document.getElementById('radial-menu-' + menuId);
            const filtersPills = document.getElementById('map-filters-pills');
            
            // Si abrimos 'add', cerramos filtros
            if (menuId === 'add') {
                if (wrapper) wrapper.classList.toggle('open');
                if (filtersPills) filtersPills.classList.remove('open');
            }
        };

        window.toggleFilters = function() {
            const filtersPills = document.getElementById('map-filters-pills');
            const addMenu = document.getElementById('radial-menu-add');
            
            if (filtersPills) filtersPills.classList.toggle('open');
            if (addMenu) addMenu.classList.remove('open');
        };

        window.selectMapLayer = function(layerId) {
            // Update active state visually
            document.querySelectorAll('.filter-pill').forEach(btn => {
                btn.classList.remove('active');
                if (btn.innerText.includes('Incendios')) {
                    btn.style.background = 'transparent';
                    btn.style.color = '#ef4444';
                } else if (btn.innerText.includes('Embalses')) {
                    btn.style.background = 'transparent';
                    btn.style.color = '#3b82f6';
                } else if (btn.innerText.includes('Seísmos')) {
                    btn.style.background = 'transparent';
                    btn.style.color = '#f97316';
                }
            });
            const currentEvent = typeof window !== 'undefined' ? window.event : null;
            if (currentEvent && currentEvent.currentTarget) {
                const target = currentEvent.currentTarget;
                target.classList.add('active');
                if (layerId === 'incendios') {
                    target.style.background = '#ef4444';
                    target.style.color = 'white';
                } else if (layerId === 'embalses') {
                    target.style.background = '#3b82f6';
                    target.style.color = 'white';
                } else if (layerId === 'sismos') {
                    target.style.background = '#f97316';
                    target.style.color = 'white';
                }
            }
            
            // Close menu
            const filtersPills = document.getElementById('map-filters-pills');
            if (filtersPills) filtersPills.classList.remove('open');
            
            // Logica del Mapa
            const map = window.currentMap;
            const L = window.L;
            if (!map || !L) { console.error('Mapa no inicializado:', {map: !!window.currentMap, L: !!window.L}); return; }

            // Limpiar capas previas
            if (window.effisLayers) {
                window.effisLayers.forEach(layer => map.removeLayer(layer));
                window.effisLayers = [];
            }
            if (window.waterLayers) {
                window.waterLayers.forEach(layer => map.removeLayer(layer));
                window.waterLayers = [];
            }
            if (window.currentFireMarkers) {
                window.currentFireMarkers.forEach(layer => map.removeLayer(layer));
                window.currentFireMarkers = [];
            }
            if (window.currentSismosMarkers) {
                window.currentSismosMarkers.forEach(layer => map.removeLayer(layer));
                window.currentSismosMarkers = [];
            }
            if (window.airLayers) {
                window.airLayers.forEach(layer => map.removeLayer(layer));
                window.airLayers = [];
            }
            
            
            if (layerId === 'sismos') {
                fetch('/api/sismos')
                    .then(res => res.json())
                    .then(sismos => {
                        window.currentSismosMarkers = [];
                        
                        const now = Date.now();
                        const recentSismos = sismos.filter(sismo => (now - sismo.timestamp) <= 3 * 24 * 60 * 60 * 1000); // 3 días
                        
                        if (recentSismos.length === 0) {
                            const pill = document.getElementById('map-info-pill');
                            const container = document.getElementById('map-ui-container');
                            if (pill && container) {
                                document.getElementById('map-info-label').innerText = 'SISMOLOGÍA';
                                document.getElementById('map-info-label').style.color = '#10b981';
                                document.getElementById('map-info-title').innerText = 'Todo tranquilo 😌';
                                document.getElementById('map-info-desc').innerHTML = 
                                    '<div style="margin-top:8px; color:var(--text-secondary); line-height: 1.4;">No se han registrado seísmos en España en los últimos 3 días.</div>' +
                                    '<div style="margin-top: 12px; padding-top: 10px; border-top: 1px solid var(--header-border); font-size: 11px; color: var(--text-secondary); display: flex; align-items: center; gap: 6px;">' +
                                        '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>' +
                                        'Fuente: Instituto Geográfico Nacional' +
                                    '</div>';
                                container.style.opacity = '1';
                                container.style.pointerEvents = 'auto';
                                container.style.transform = 'translate(-50%, 0)';
                            }
                            return;
                        }

                        recentSismos.forEach(sismo => {
                            let radius = 4;
                            let color = '#9ca3af'; // gris por defecto
                            
                            // Escala Richter extendida (para prepararnos ante terremotos fuertes)
                            if (sismo.mag < 2.0) {
                                radius = 4; color = '#9ca3af'; // Micro
                            } else if (sismo.mag < 3.0) {
                                radius = 6; color = '#fbbf24'; // Menor
                            } else if (sismo.mag < 4.0) {
                                radius = 8; color = '#f97316'; // Ligero
                            } else if (sismo.mag < 5.0) {
                                radius = 12; color = '#ef4444'; // Moderado
                            } else if (sismo.mag < 6.0) {
                                radius = 18; color = '#dc2626'; // Fuerte
                            } else if (sismo.mag < 7.0) {
                                radius = 24; color = '#b91c1c'; // Mayor
                            } else {
                                radius = 32; color = '#7f1d1d'; // Gran terremoto
                            }

                            const marker = L.circleMarker([sismo.lat, sismo.lon], {
                                radius: radius,
                                fillColor: color,
                                color: '#ffffff', // borde blanco para destacar
                                weight: 1,
                                opacity: 1,
                                fillOpacity: 0.7
                            }).addTo(map);

                            marker.on('click', () => {
                                const pill = document.getElementById('map-info-pill');
                                const container = document.getElementById('map-ui-container');
                                if (!pill || !container) return;

                                const diffHours = Math.floor((now - sismo.timestamp) / (1000 * 60 * 60));
                                const diffMins = Math.floor((now - sismo.timestamp) / (1000 * 60));
                                const diffDays = Math.floor(diffHours / 24);
                                
                                let timeStr = '';
                                if (diffDays > 0) {
                                    timeStr = diffDays === 1 ? 'Hace 1 día' : 'Hace ' + diffDays + ' días';
                                } else if (diffHours > 0) {
                                    timeStr = diffHours === 1 ? 'Hace 1 hora' : 'Hace ' + diffHours + ' horas';
                                } else {
